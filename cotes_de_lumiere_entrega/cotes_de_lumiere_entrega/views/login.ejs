<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Côtes de Lumière | Vinhos Especiais</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/luxo.css">
</head>
<body data-cl-page="login" class="cl-login-page login-bg">
    <div class="cl-login-art" aria-hidden="true"><div class="cl-login-art-inner"><span>CÔTES DE LUMIÈRE</span><h2>Vinhos que<br>iluminam momentos.</h2><div class="cl-login-art-rule"></div><p>Uma experiência especial começa aqui.</p></div></div>
    <main class="cl-login-panel"><div class="cl-login-form-wrap">
        <div class="flex items-center gap-3 mb-8">
            <img src="/imagens/logo.jpg" alt="Emblema Côtes de Lumière" class="w-10 h-10 object-contain rounded-full border border-amber-500/50">
            <div>
                <h1 class="font-['Cormorant_Garamond'] text-xl font-bold tracking-[0.2em] text-white uppercase leading-none">CÔTES DE LUMIÈRE</h1>
                <p class="text-[9px] tracking-[0.25em] text-amber-300 font-medium uppercase mt-1">VINHOS QUE ILUMINAM MOMENTOS</p>
            </div>
        </div>

        <div id="form-login" class="space-y-6">
            <div>
                <h2 class="font-['Cormorant_Garamond'] italic text-4xl font-bold text-white mb-2">Bem-vindo de <span class="not-italic text-amber-300">volta!</span></h2>
                <p class="text-xs text-stone-400">Que bom ter você aqui novamente.</p>
            </div>
            <form action="/login" method="POST" class="space-y-4">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-amber-400 text-sm"><i class="fa-regular fa-user"></i></span>
                    <input type="text" name="email" required placeholder="E-mail ou Nome" class="w-full bg-black/60 border border-amber-500/30 rounded-xl py-3.5 pl-11 pr-4 text-xs text-white focus:outline-none focus:border-amber-400">
                </div>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-amber-400 text-sm"><i class="fa-solid fa-lock text-xs"></i></span>
                    <input type="password" name="senha" required placeholder="Senha" class="w-full bg-black/60 border border-amber-500/30 rounded-xl py-3.5 pl-11 pr-4 text-xs text-white focus:outline-none focus:border-amber-400">
                </div>
                <button type="submit" class="w-full py-4 bg-[#330A11] hover:bg-[#4A0E17] text-amber-200 font-bold text-xs uppercase tracking-widest rounded-xl border border-amber-500/40 transition-all shadow-lg">
                    Entrar
                </button>
            </form>
            <p class="text-xs text-center text-stone-400">Não tem conta? <button onclick="toggleAuth('register')" class="text-amber-300 underline font-semibold">Cadastre-se</button></p>
        </div>

        <div id="form-register" class="space-y-6 hidden">
            <div>
                <h2 class="font-['Cormorant_Garamond'] italic text-4xl font-bold text-white mb-2">Cadastre-se</h2>
                <p class="text-xs text-stone-400">Crie sua conta para explorar o acervo.</p>
            </div>
            <form action="/register" method="POST" class="space-y-4">
                <input type="text" name="nome" required placeholder="Nome completo" class="w-full bg-black/60 border border-amber-500/30 rounded-xl py-3 px-4 text-xs text-white">
                <input type="email" name="email" required placeholder="E-mail" class="w-full bg-black/60 border border-amber-500/30 rounded-xl py-3 px-4 text-xs text-white">
                <input type="password" name="senha" required placeholder="Senha" class="w-full bg-black/60 border border-amber-500/30 rounded-xl py-3 px-4 text-xs text-white">
                <button type="submit" class="w-full py-3.5 bg-[#330A11] hover:bg-[#4A0E17] text-amber-200 font-bold text-xs uppercase tracking-widest rounded-xl border border-amber-500/40">Criar Conta</button>
            </form>
            <p class="text-xs text-center text-stone-400">Já tem conta? <button onclick="toggleAuth('login')" class="text-amber-300 underline font-semibold">Entrar</button></p>
        </div>
    </div></main>
    <script>
        function toggleAuth(view) {
            document.getElementById('form-login').classList.toggle('hidden', view !== 'login');
            document.getElementById('form-register').classList.toggle('hidden', view !== 'register');
        }
    </script>
</body>
</html>
